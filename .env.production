# The racecar instance on gamerelay.io (a public key: safe to ship). Its allowed origins are set in the dashboard.
VITE_GAMERELAY_KEY=gr_pub_JwVI0D9KTipNnjxvX4ICaG23

# The soundtrack, on the games CDN: https://cdn.gamerelay.io is gamerelay.io's caching proxy for
# the asset store's `assets/` folder (tools/publish-assets.ts uploads to `assets/racecar/`). It
# always sends the CORS header Web Audio needs (the Space's own CDN doesn't).
VITE_MUSIC_URL=https://cdn.gamerelay.io/racecar/music
